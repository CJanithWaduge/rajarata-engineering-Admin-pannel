{
  "name": "rajarata-engineering-admin-pannel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:emulator": "npx --yes firebase-tools@^15 emulators:exec --project demo-rajarata-home --only auth,firestore,storage \"vitest run --config vitest.emulator.config.ts\"",
    "test:emulator:only": "vitest run --config vitest.emulator.config.ts",
    "deploy:rules": "npx --yes firebase-tools@^15 deploy --only firestore:rules",
    "deploy:storage:rules": "npx --yes firebase-tools@^15 deploy --only storage",
    "build:hosting": "npm run lint && npm run test:run && npm run build",
    "deploy:hosting": "node --env-file-if-exists=.env scripts/deploy-hosting.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
