rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is either:
    //   1. admins/{uid}     — the original, revocation-friendly record, or
    //   2. admins/{email}   — an allowlist entry keyed by the account email.
    //
    // The email form exists so provisioning is simple from the Firebase
    // Console: create the user in Authentication, then add a Firestore
    // document in `admins` whose Document ID is that email (lowercase), with
    // `active: true`. No uid copying required.
    //
    // Trade-off: if an Auth account is deleted and the same address is
    // registered again, the new uid inherits the grant. Controlling the
    // mailbox is therefore part of admin access.
    function isActiveDoc(id) {
      return exists(/databases/$(database)/documents/admins/$(id))
        && get(/databases/$(database)/documents/admins/$(id)).data.active != false;
    }

    function isAdmin() {
      return request.auth != null
        && (isActiveDoc(request.auth.uid)
          || (request.auth.token.email is string
            && isActiveDoc(request.auth.token.email.lower())));
    }

    // Admin provisioning is manual (Firebase Console / Admin SDK).
    // A signed-in user may read only their own record — by uid or by email.
    // Nobody can write admin records from the client.
    match /admins/{key} {
      allow read: if request.auth != null
        && (key == request.auth.uid
          || (request.auth.token.email is string
            && key.lower() == request.auth.token.email.lower()));
      allow write: if false;
    }

    // Site-wide settings singleton: contact details, links, business identity.
    // Public read is required and deliberate — the marketing site is a static
    // build with no server, so it reads this document from the browser.
    // Never store anything here that is not already published on the site.
    match /site/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Home page singleton: hero media, three featured project cards, and the
    // three "Our Electrical Services" cards. The public site hydrates the Home
    // page from this document, so read is public by design. Shape checks are a
    // backstop; the admin form validates every value and every image before it
    // writes.
    function isValidHomeContent() {
      return request.resource.data.hero is map
        && request.resource.data.featuredProjects is list
        && request.resource.data.featuredProjects.size() == 3
        && request.resource.data.featuredServices is list
        && request.resource.data.featuredServices.size() == 3
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    match /site/home {
      allow read: if true;
      allow create, update: if isAdmin() && isValidHomeContent();
      allow delete: if isAdmin();
    }

    // Services page singleton: fixed-count copy and icon slots. The public
    // site hydrates the prerendered page from this document, so read is public
    // by design. The top-level key allowlist is deliberate: contact details,
    // footer copy, images, and SEO fields must never be added here.
    function isValidServicesContent() {
      return request.resource.data.keys().hasOnly(
          ['hero', 'directory', 'services', 'process', 'cta', 'updatedAt', 'updatedBy'])
        && request.resource.data.hero is map
        && request.resource.data.hero.quickLinks is list
        && request.resource.data.hero.quickLinks.size() == 4
        && request.resource.data.hero.metrics is list
        && request.resource.data.hero.metrics.size() == 4
        && request.resource.data.directory is map
        && request.resource.data.services is list
        && request.resource.data.services.size() == 8
        && request.resource.data.process is map
        && request.resource.data.process.steps is list
        && request.resource.data.process.steps.size() == 6
        && request.resource.data.cta is map
        && request.resource.data.cta.points is list
        && request.resource.data.cta.points.size() == 2
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    match /site/services {
      allow read: if true;
      allow create, update: if isAdmin() && isValidServicesContent();
      allow delete: if isAdmin();
    }

    // About page singleton: one hero image, story, vision/mission, pillars,
    // methodology, industries, and CTA copy. The public site hydrates the About
    // page from this document once its reader is wired in, so read is public by
    // design. Contact details, footer copy, and SEO stay out of this document.
    function isValidAboutContent() {
      return request.resource.data.keys().hasOnly(
          ['hero', 'heritage', 'visionMission', 'pillars', 'methodology',
            'industries', 'cta', 'updatedAt', 'updatedBy'])
        && request.resource.data.hero is map
        && request.resource.data.hero.image is map
        && request.resource.data.hero.image.imageUrl is string
        && request.resource.data.hero.snapshots is list
        && request.resource.data.hero.snapshots.size() == 3
        && request.resource.data.heritage is map
        && request.resource.data.heritage.milestones is list
        && request.resource.data.heritage.milestones.size() == 4
        && request.resource.data.visionMission is map
        && request.resource.data.pillars is map
        && request.resource.data.pillars.items is list
        && request.resource.data.pillars.items.size() == 5
        && request.resource.data.methodology is map
        && request.resource.data.methodology.steps is list
        && request.resource.data.methodology.steps.size() == 5
        && request.resource.data.industries is map
        && request.resource.data.industries.sectors is list
        && request.resource.data.industries.sectors.size() == 6
        && request.resource.data.cta is map
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    match /site/about {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAboutContent();
      allow delete: if isAdmin();
    }

    // Projects page singleton: hero copy, six fixed project cards, three
    // track-record columns, and CTA copy. The public site hydrates the
    // prerendered page from this document, so read is public by design. The
    // top-level key allowlist is deliberate: contact details, footer copy,
    // images, and SEO fields must never be added here.
    function isValidProjectsContent() {
      return request.resource.data.keys().hasOnly(
          ['hero', 'portfolio', 'trackRecord', 'cta', 'updatedAt', 'updatedBy'])
        && request.resource.data.hero is map
        && request.resource.data.portfolio is map
        && request.resource.data.portfolio.projects is list
        && request.resource.data.portfolio.projects.size() == 6
        && request.resource.data.trackRecord is map
        && request.resource.data.trackRecord.columns is list
        && request.resource.data.trackRecord.columns.size() == 3
        && request.resource.data.cta is map
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    match /site/projects {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProjectsContent();
      allow delete: if isAdmin();
    }

    // Any other content collection is added explicitly in a later phase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
