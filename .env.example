VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional. Firestore database id; defaults to `(default)`.
# Required only when the project runs on a named database (for example when
# the free plan blocks creating the default one via the API).
VITE_FIREBASE_DATABASE_ID=default

# Test-only. Set to `true` only while running `npm run test:emulator`; it points
# Auth, Firestore, and Storage at the local emulators. Leave empty otherwise.
VITE_FIREBASE_USE_EMULATOR=

# Media storage. Inline mode is the default: compressed Home images are stored
# as data URLs in `site/home`, which works without a Storage bucket (Spark plan).
# Set to `false` after provisioning Firebase Storage to use the upload path.
VITE_FIREBASE_INLINE_MEDIA=true
